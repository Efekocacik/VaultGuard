#!/usr/bin/env bpftrace
/*
 * vaultguard_monitor.bt — VaultGuard Gercek Zamanli eBPF Izleyici
 *
 * Tum VaultGuard tracepoint'lerini dinler ve olaylari formatli
 * olarak terminale yazdirir. Temel SIEM senaryolarinda kullanilabilir.
 *
 * Kullanim:
 *   sudo bpftrace vaultguard_monitor.bt
 *
 * On kosul:
 *   - VaultGuard kernel modulu yuklu olmali
 *   - bpftrace kurulu olmali (apt install bpftrace)
 *
 * Author: Efe
 */

BEGIN
{
    printf("==================================================\n");
    printf("  VaultGuard v2.0 - eBPF Guvenlik Izleyici Aktif\n");
    printf("  Cikmak icin Ctrl+C\n");
    printf("==================================================\n\n");
}

/* -- Olay 1: Canary Tuzagi -- */
tracepoint:vaultguard:vg_canary_trap
{
    printf("[%s] [ALARM] CANARY TRAP!\n", strftime("%H:%M:%S", nsecs));
    printf("     Saldirgan PID : %d\n",  args->attacker_pid);
    printf("     Sahip PID     : %d\n",  args->owner_pid);
    printf("     Red Sebebi    : %d\n",  args->deny_reason);
    printf("\n");
}

/* -- Olay 2: Bellek Imhasi -- */
tracepoint:vaultguard:vg_secret_wiped
{
    $reason = args->reason_code == 1 ? "TTL Doldu" :
              args->reason_code == 2 ? "Acil Imha" : "Manuel Silme";
    printf("[%s] [IMHA] BELLEK IMHASI | Etiket: %s | Sebep: %s\n",
           strftime("%H:%M:%S", nsecs), args->label, $reason);
    printf("\n");
}

/* -- Olay 3: Sir Depolandi -- */
tracepoint:vaultguard:vg_secret_stored
{
    printf("[%s] [OK] SIR DEPOLANDI\n", strftime("%H:%M:%S", nsecs));
    printf("     Etiket  : %s\n",  args->label);
    printf("     Sahip PID: %d  UID: %d\n", args->owner_pid, args->owner_uid);
    printf("     TTL     : %lu sn\n", args->ttl_sec);
    printf("\n");
}

/* -- Olay 4: Erisim Reddedildi -- */
tracepoint:vaultguard:vg_access_denied
{
    printf("[%s] [RED] ERISIM REDDEDILDI\n", strftime("%H:%M:%S", nsecs));
    printf("     Girisimci PID: %d  UID: %d\n",
           args->attacker_pid, args->attacker_uid);
    printf("     Etiket  : %s\n",  args->label);
    printf("     Red Sebebi: %d\n", args->deny_reason);
    printf("\n");
}

/* -- Olay 5: Karantina Degisimi -- */
tracepoint:vaultguard:vg_quarantine_toggle
{
    $state = args->new_state ? "ETKIN (LOCKDOWN)" : "DEVRE DISI";
    printf("[%s] [LOCK] KARANTINA: %s - Degistiren PID: %d\n",
           strftime("%H:%M:%S", nsecs), $state, args->changed_by_pid);
    printf("\n");
}

/* -- Olay 6: Kripto Operasyonu -- */
tracepoint:vaultguard:vg_crypto_operation
{
    $op  = args->op ? "Decrypt" : "Encrypt";
    $res = args->success ? "OK" : "HATA";
    printf("[%s] [KRIPTO] %s | %s | Etiket: %s\n",
           strftime("%H:%M:%S", nsecs), $op, $res, args->label);
    printf("\n");
}

/* -- Istatistik Ozeti (her 30 saniyede) -- */
interval:s:30
{
    printf("==================================================\n");
    printf("[%s] [OZET] 30 SANIYE OZETI\n", strftime("%H:%M:%S", nsecs));
    printf("==================================================\n\n");
}

END
{
    printf("\n[Izleyici sonlandirildi]\n");
}
